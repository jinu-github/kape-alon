{
  "name": "kape-alon",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev:web": "npm run dev -w @kape/web",
    "dev:api": "npm run dev -w @kape/api",
    "build": "npm run build -w @kape/shared && npm run build -w @kape/api && npm run build -w @kape/web",
    "typecheck": "npm run build -w @kape/shared && npm run typecheck --workspaces --if-present && tsc -p tsconfig.tests.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run build -w @kape/shared && vitest run",
    "test:integration": "npm run build -w @kape/shared && node --env-file=apps/api/.env scripts/test-integration.mjs",
    "test:e2e": "npm run build -w @kape/shared && node --env-file=apps/api/.env node_modules/@playwright/test/cli.js test",
    "db:generate": "npm run db:generate -w @kape/api",
    "db:migrate": "npm run db:migrate -w @kape/api",
    "seed": "npm run seed -w @kape/api"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.0.0",
    "eslint": "^10.0.0",
    "prettier": "^3.0.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.0.0",
    "vitest": "^5.0.5"
  }
}
