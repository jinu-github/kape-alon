NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://kape:kape_local_only@localhost:5432/kape_alon
# Exact frontend origin; no trailing slash. Use your Vercel origin in production.
WEB_ORIGIN=http://localhost:5173
# Number of trusted reverse-proxy hops; keep 0 locally, verify topology before production.
TRUST_PROXY_HOPS=0
# Seed is intentionally blocked unless this is true. Keep false on non-demo databases.
ALLOW_DEMO_RESET=true
# Demo-only credential; bcrypt-hashed during seeding. Never use a real password.
DEMO_PASSWORD=kape-demo-2026

# Generate a random secret of at least 32 characters; never expose it to Vite.
JWT_SECRET=replace-with-at-least-32-random-characters
# Only enable for a dedicated, public demo database (reveals demo login credentials).
DEMO_MODE=true
