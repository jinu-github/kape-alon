{
  "name": "@kape/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --conditions=development --watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.tools.json",
    "db:generate": "node --env-file-if-exists=.env ../../node_modules/drizzle-kit/bin.cjs generate",
    "db:migrate": "node --env-file-if-exists=.env --conditions=development scripts/migrate.ts",
    "seed": "node --env-file-if-exists=.env --conditions=development scripts/seed.ts"
  },
  "dependencies": {
    "@kape/shared": "*",
    "bcrypt": "^6.0.0",
    "drizzle-orm": "^0.45.4",
    "express": "^5.1.0",
    "pg": "^8.16.0",
    "socket.io": "^4.8.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.0",
    "@types/pg": "^8.15.0",
    "drizzle-kit": "^0.31.0"
  }
}
